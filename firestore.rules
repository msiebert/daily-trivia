rules_version = '2';

// Daily Trivia is single-user-per-project: each person runs their own Firebase
// project, and only their own signed-in account should ever be able to
// read or write their data. There is no sharing between users within a
// project.
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user progress doc, keyed by Firebase Auth uid. Schema:
    // docs/firestore-schema.md
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
